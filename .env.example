# ===========================================================================
# AI Tester Agent — environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit a real .env file. All values below are placeholders.
# ===========================================================================

# --- Azure OpenAI (drives both the browser agent and result matching) ---
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# --- Foundry IQ (REQUIRED — grounded knowledge retrieval) ---
# Azure AI Foundry project + knowledge source used to ground test context.
# See docs/ARCHITECTURE.md for how this is used.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com/api/projects/your-project
FOUNDRY_KNOWLEDGE_SOURCE=test-knowledge
FOUNDRY_IQ_ENABLED=true

# --- Azure DevOps (where test results + video are reported) ---
ADO_ORGANIZATION=your-organization
ADO_PROJECT=your-project
ADO_PERSONAL_ACCESS_TOKEN=your-ado-pat
# Test Plan the agent reports results into
ADO_PLAN_ID=0
# Saved query (GUID) that returns the User Stories / Test Cases to run
ADO_TEST_QUERY_ID=00000000-0000-0000-0000-000000000000

# --- Browser agent behavior ---
AGENT_MAX_STEPS=25
AGENT_MAX_ACTIONS_PER_STEP=5
AGENT_RECORD_VIDEO=true
# Headless is recommended for CI; set false to watch the run locally
AGENT_HEADLESS=true

# --- Target application under test (use a PUBLIC demo app, never internal) ---
TARGET_BASE_URL=https://example.com
